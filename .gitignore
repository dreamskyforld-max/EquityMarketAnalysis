# ── 敏感配置（不传 GitHub）──
config.conf
db_config.json
ticker_config.json
.env

# ── 虚拟环境 ──
.venv/
__pycache__/
.idea/
.coverage

# ── 部署 / 系统服务文件 ──
system/

# ── 日志 ──
*.log
log/

# ── 数据与缓存产物 ──
benchmark_data.txt
excess_return_data.txt
quote_data.txt
money_flow_data.txt
trend_cache/*.json
trend_cache/*.txt
south_cache_*.json
margin_cache_*.json
stock_list_cache.json
a_backfill_progress.json
*.csv

# ── 开发临时脚本（不传 GitHub）──
test.py
test_ticker.py

# ── Markdown 文档（默认不传 GitHub，仅设计与正式文档放行）──
*.md
# README 是项目正式文档，需要入库
!README.md
# 设计/规范/研究类文档入库（doc/ 与 research/ 下）；部署不传服务器仍由 deploy.sh 的 rsync --exclude '*.md' 控制
!doc/**/*.md
!research/**/*.md

# ── 测试缓存 ──
.pytest_cache/

# ── schema 反向 dump 临时镜像（review 用，不入库）──
sql/schema.sql.generated

# ── schema 差异修复 SQL（服务器待执行产物，不入库）──
sql/schema_fix_*.sql
research/force_segmentation/labels/*
research/force_segmentation/results/*
